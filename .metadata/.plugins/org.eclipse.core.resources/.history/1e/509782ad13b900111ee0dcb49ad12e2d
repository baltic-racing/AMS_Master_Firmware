uint8_t CDC_SendNonBlocking(uint8_t *buf, uint16_t len)
{
    if (hUsbDeviceFS.dev_state != USBD_STATE_CONFIGURED)
    {
        return 0;
    }

    if (CDC_Transmit_FS(buf, len) == USBD_OK)
    {
        return 1;
    }

    return 0;
}
