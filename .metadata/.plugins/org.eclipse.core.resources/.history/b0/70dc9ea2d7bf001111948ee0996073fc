void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    static uint8_t have_falling = 0;
    static uint8_t have_rising = 0;
    static uint32_t previous_falling = 0;

    uint32_t now;
    uint32_t period;
    uint32_t low;

    if (htim->Instance != TIM9)
    {
        return;
    }

    /* Steigende Flanke: frische Pulsbreitenmessung vorhanden */
    if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1)
    {
        have_rising = 1U;
        return;
    }

    if (htim->Channel != HAL_TIM_ACTIVE_CHANNEL_2)
    {
        return;
    }

    now = HAL_GetTick();

    period = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);
    low = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1);

    /*
     * Erste unvollstaendige Periode verwerfen.
     * Nach laengerer Pause ebenfalls neu synchronisieren.
     */
    if (have_falling &&
        (uint32_t)(now - previous_falling) <= IMD_TIMEOUT_MS)
    {
        imd_period = period;
        imd_low = have_rising ? low : 0U;

        if ((htim->Instance->SR &
            (TIM_SR_CC1OF | TIM_SR_CC2OF)) != 0U)
        {
            imd_low = 0U;
        }

        imd_last_capture = now;
        imd_seen = 1U;
    }

    __HAL_TIM_CLEAR_FLAG(
        htim,
        TIM_FLAG_CC1OF | TIM_FLAG_CC2OF
    );

    previous_falling = now;
    have_falling = 1U;
    have_rising = 0U;
}

