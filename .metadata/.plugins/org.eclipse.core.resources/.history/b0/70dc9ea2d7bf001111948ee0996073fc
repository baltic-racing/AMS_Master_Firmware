		PEC_ERROR = 1;
	}

}

void checkIMD(void)
{
    uint8_t healthy =
        (imd_diag.code == IMD_NORMAL ||
         imd_diag.code == IMD_SST_GOOD);

    if (healthy && IMD_ERROR == 0U)
    {
        imd_error_time = HAL_GetTick();
    }

    if (!healthy &&
        (uint32_t)(HAL_GetTick() - imd_error_time)
        >= imd_detect_time)
    {
        IMD_ERROR = 1U;
    }

    IMD_ERROR_CAN = IMD_ERROR;
}

