	}
	if (HAL_GetTick()>= last100 + 100)
	{
		send_can_10_message = 1;
		//CAN_10(AMS1_databytes);

		HAL_GPIO_TogglePin(GPIOA, WDI_Pin);		// toggle watchdog
		HAL_GPIO_TogglePin(GPIOC, LED_GN_Pin);	// toggle LED
		last100 = HAL_GetTick();
		send_usb_message = 1;
		//send_usb();
	}
}



